# Vercel Blob token used to publish the data snapshot (no Postgres anywhere).
BLOB_READ_WRITE_TOKEN=
# Optional explicit snapshot URL. If unset, the app discovers it from the token.
SNAPSHOT_URL=

# Secret used by cron-job.org / GitHub Actions to trigger POST /api/ingest/run
INGEST_SECRET=change-me

# Canonical origin for sitemap, RSS and hreflang URLs
NEXT_PUBLIC_SITE_URL=https://openweightradar.com

# Optional HF token — raises the rate limit from 500/300s to the authenticated tier
HF_TOKEN=

# Optional public source repository shown in the footer. Left unset, the link
# is hidden (a guessed URL previously shipped as a dead 404).
NEXT_PUBLIC_REPO_URL=

# Search Console / Bing verification tokens. Emitted only when set; the layout
# reads them in `generateMetadata`.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
